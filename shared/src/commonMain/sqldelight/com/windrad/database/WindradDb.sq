-- Tabelle: Alle Windkrafteinheiten aus dem Marktstammdatenregister
CREATE TABLE windmill_units (
    unit_MaStR_ID TEXT PRIMARY KEY,
    unit_display_name TEXT,
    operating_status TEXT,
    unit_gross_capacity REAL,
    unit_net_nominal_capacity REAL,
    unit_commissioning_date TEXT,
    unit_registration_date TEXT,
    federal_state TEXT,
    postal_code TEXT,
    city TEXT,
    cadastral_district TEXT,
    municipality_code TEXT,
    municipality TEXT,
    district TEXT,
    latitude_wgs84 REAL,
    longitude_wgs84 REAL,
    power_generation_technology TEXT,
    feed_in_type TEXT,
    wind_plant_name TEXT,
    onshore_offshore_type TEXT,
    turbine_hub_height REAL,
    turbine_rotor_diameter REAL,
    turbine_manufacturer TEXT,
    type_designation TEXT,
    final_decommissioning_date TEXT,
    planned_commissioning_date TEXT,
    plant_operator_name_org TEXT,
    operator_mastr_no TEXT,
    connecting_grid_operator_name TEXT,
    voltage_level TEXT,
    eeg_plant_commissioning_date TEXT,
    eeg_plant_installed_capacity REAL
);

CREATE INDEX IF NOT EXISTS idx_windmill_coords ON windmill_units(latitude_wgs84, longitude_wgs84);

-- Tabelle: Sammelstatus jeder Einheit
CREATE TABLE collected_windmill_units (
    unit_MaStR_ID TEXT PRIMARY KEY,
    collected INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    FOREIGN KEY(unit_MaStR_ID) REFERENCES windmill_units(unit_MaStR_ID)
);

-- Tabelle: Vergleichs-Sehenswürdigkeiten für Höhenvergleich
CREATE TABLE comparable_sights (
    id INTEGER PRIMARY KEY,
    name TEXT NOT NULL,
    height REAL NOT NULL
);

-- ============================================================
-- Queries
-- ============================================================

-- Alle Windräder mit Collection-Status (JOIN)
selectAllWindmillsWithCollectionStatus:
SELECT w.*, IFNULL(c.collected, 0) AS collected
FROM windmill_units w
LEFT JOIN collected_windmill_units c ON w.unit_MaStR_ID = c.unit_MaStR_ID;

-- Einzelnes Windrad nach ID
selectWindmillById:
SELECT w.*, IFNULL(c.collected, 0) AS collected
FROM windmill_units w
LEFT JOIN collected_windmill_units c ON w.unit_MaStR_ID = c.unit_MaStR_ID
WHERE w.unit_MaStR_ID = ?;

-- Windräder nach Bundesland filtern
selectWindmillsByFederalState:
SELECT w.*, IFNULL(c.collected, 0) AS collected
FROM windmill_units w
LEFT JOIN collected_windmill_units c ON w.unit_MaStR_ID = c.unit_MaStR_ID
WHERE w.federal_state = ?;

-- Nur gesammelte Windräder
selectCollectedWindmills:
SELECT w.*, IFNULL(c.collected, 0) AS collected
FROM windmill_units w
INNER JOIN collected_windmill_units c ON w.unit_MaStR_ID = c.unit_MaStR_ID
WHERE c.collected = 1;

-- Nur nicht gesammelte Windräder
selectUncollectedWindmills:
SELECT w.*, IFNULL(c.collected, 0) AS collected
FROM windmill_units w
LEFT JOIN collected_windmill_units c ON w.unit_MaStR_ID = c.unit_MaStR_ID
WHERE IFNULL(c.collected, 0) = 0;

-- Alle Einheiten eines Windparks
selectWindmillsByWindPark:
SELECT w.*, IFNULL(c.collected, 0) AS collected
FROM windmill_units w
LEFT JOIN collected_windmill_units c ON w.unit_MaStR_ID = c.unit_MaStR_ID
WHERE w.wind_plant_name = ?;

-- Generisches Update des Collection-Status einer einzelnen Einheit
updateCollectionStatus:
INSERT OR REPLACE INTO collected_windmill_units (unit_MaStR_ID, collected)
VALUES (?, ?);

-- Einzelne Einheit freischalten
collectSingleUnit:
UPDATE collected_windmill_units
SET collected = 1
WHERE unit_MaStR_ID = ?;

-- Ganzen Windpark freischalten (alle Einheiten mit gleichem wind_plant_name)
collectWindPark:
UPDATE collected_windmill_units
SET collected = 1
WHERE unit_MaStR_ID IN (
    SELECT unit_MaStR_ID FROM windmill_units WHERE wind_plant_name = ?
);

-- Anzahl gesammelt und gesamt pro Bundesland
countCollectedByFederalState:
SELECT
    w.federal_state,
    COUNT(*) AS total,
    SUM(CASE WHEN IFNULL(c.collected, 0) = 1 THEN 1 ELSE 0 END) AS collected_count
FROM windmill_units w
LEFT JOIN collected_windmill_units c ON w.unit_MaStR_ID = c.unit_MaStR_ID
GROUP BY w.federal_state
ORDER BY w.federal_state;

-- Gesamtanzahl gesammelt und gesamt
countTotalCollected:
SELECT
    COUNT(*) AS total,
    SUM(CASE WHEN IFNULL(c.collected, 0) = 1 THEN 1 ELSE 0 END) AS collected_count
FROM windmill_units w
LEFT JOIN collected_windmill_units c ON w.unit_MaStR_ID = c.unit_MaStR_ID;

-- Gefundene Einheiten (optional nach Bundesland), alphabetisch nach Gemeinde
selectFoundTurbinesByState:
SELECT w.unit_MaStR_ID, w.municipality, w.unit_display_name
FROM windmill_units w
INNER JOIN collected_windmill_units c ON w.unit_MaStR_ID = c.unit_MaStR_ID
WHERE c.collected = 1 AND (:state IS NULL OR w.federal_state = :state)
ORDER BY w.municipality COLLATE NOCASE;

-- Nicht gefundene Einheiten (optional nach Bundesland), alphabetisch nach Gemeinde
selectNotFoundTurbinesByState:
SELECT w.unit_MaStR_ID, w.municipality, w.unit_display_name
FROM windmill_units w
LEFT JOIN collected_windmill_units c ON w.unit_MaStR_ID = c.unit_MaStR_ID
WHERE IFNULL(c.collected, 0) = 0 AND (:state IS NULL OR w.federal_state = :state)
ORDER BY w.municipality COLLATE NOCASE;

-- Liste aller vorhandenen Bundesländer
selectAllFederalStates:
SELECT DISTINCT federal_state
FROM windmill_units
WHERE federal_state IS NOT NULL
ORDER BY federal_state;

-- Alle Vergleichsobjekte
selectAllComparableSights:
SELECT *
FROM comparable_sights
ORDER BY height;

-- Zoom-basierte Aggregationsabfragen für Karten-Clustering

selectWindmillCoordinates:
SELECT
    w.unit_MaStR_ID AS id,
    w.unit_display_name AS label,
    w.latitude_wgs84 AS latitude,
    w.longitude_wgs84 AS longitude,
    w.operating_status AS status,
    IFNULL(c.collected, 0) AS collected
FROM windmill_units w
LEFT JOIN collected_windmill_units c ON w.unit_MaStR_ID = c.unit_MaStR_ID
WHERE w.latitude_wgs84 IS NOT NULL AND w.longitude_wgs84 IS NOT NULL;

countWindmillsByFederalState:
SELECT
    w.federal_state AS id,
    w.federal_state AS label,
    COUNT(*) AS total_count,
    AVG(w.latitude_wgs84) AS avg_latitude,
    AVG(w.longitude_wgs84) AS avg_longitude,
    MIN(IFNULL(c.collected, 0)) AS all_collected
FROM windmill_units w
LEFT JOIN collected_windmill_units c ON w.unit_MaStR_ID = c.unit_MaStR_ID
WHERE w.federal_state IS NOT NULL AND w.latitude_wgs84 IS NOT NULL AND w.longitude_wgs84 IS NOT NULL
GROUP BY w.federal_state;

countWindmillsByDistrict:
SELECT
    w.district AS id,
    w.district AS label,
    COUNT(*) AS total_count,
    AVG(w.latitude_wgs84) AS avg_latitude,
    AVG(w.longitude_wgs84) AS avg_longitude,
    MIN(IFNULL(c.collected, 0)) AS all_collected
FROM windmill_units w
LEFT JOIN collected_windmill_units c ON w.unit_MaStR_ID = c.unit_MaStR_ID
WHERE w.district IS NOT NULL AND w.latitude_wgs84 IS NOT NULL AND w.longitude_wgs84 IS NOT NULL
GROUP BY w.district;

countWindmillsByMunicipality:
SELECT
    w.municipality AS id,
    w.municipality AS label,
    COUNT(*) AS total_count,
    AVG(w.latitude_wgs84) AS avg_latitude,
    AVG(w.longitude_wgs84) AS avg_longitude,
    MIN(IFNULL(c.collected, 0)) AS all_collected
FROM windmill_units w
LEFT JOIN collected_windmill_units c ON w.unit_MaStR_ID = c.unit_MaStR_ID
WHERE w.municipality IS NOT NULL AND w.latitude_wgs84 IS NOT NULL AND w.longitude_wgs84 IS NOT NULL
GROUP BY w.municipality;

countWindmillsByWindPark:
SELECT
    COALESCE(NULLIF(w.wind_plant_name, ''), w.unit_MaStR_ID) AS id,
    COALESCE(NULLIF(w.wind_plant_name, ''), w.unit_display_name, w.unit_MaStR_ID) AS label,
    COUNT(*) AS total_count,
    AVG(w.latitude_wgs84) AS avg_latitude,
    AVG(w.longitude_wgs84) AS avg_longitude,
    MIN(IFNULL(c.collected, 0)) AS all_collected
FROM windmill_units w
LEFT JOIN collected_windmill_units c ON w.unit_MaStR_ID = c.unit_MaStR_ID
WHERE w.latitude_wgs84 IS NOT NULL AND w.longitude_wgs84 IS NOT NULL
GROUP BY COALESCE(NULLIF(w.wind_plant_name, ''), w.unit_MaStR_ID);

searchLocations:
SELECT type, name, latitude, longitude
FROM (
    SELECT 'city' AS type, city AS name, AVG(latitude_wgs84) AS latitude, AVG(longitude_wgs84) AS longitude
    FROM windmill_units
    WHERE city LIKE :query
    GROUP BY city

    UNION ALL

    SELECT 'wind_plant_name' AS type, wind_plant_name AS name, AVG(latitude_wgs84) AS latitude, AVG(longitude_wgs84) AS longitude
    FROM windmill_units
    WHERE wind_plant_name LIKE :query AND wind_plant_name IS NOT NULL AND wind_plant_name != ''
    GROUP BY wind_plant_name

    UNION ALL

    SELECT 'postal_code' AS type, postal_code AS name, AVG(latitude_wgs84) AS latitude, AVG(longitude_wgs84) AS longitude
    FROM windmill_units
    WHERE postal_code LIKE :query
    GROUP BY postal_code
)
ORDER BY length(name) ASC
LIMIT 15;

selectWindmillsInBoundingBox:
SELECT
    w.unit_MaStR_ID,
    w.unit_display_name,
    w.operating_status,
    w.unit_net_nominal_capacity,
    w.onshore_offshore_type,
    w.turbine_rotor_diameter,
    w.unit_commissioning_date,
    w.final_decommissioning_date,
    w.planned_commissioning_date,
    w.latitude_wgs84,
    w.longitude_wgs84,
    w.city,
    IFNULL(c.collected, 0) AS collected
FROM windmill_units w
LEFT JOIN collected_windmill_units c ON w.unit_MaStR_ID = c.unit_MaStR_ID
WHERE w.latitude_wgs84 BETWEEN :minLat AND :maxLat
  AND w.longitude_wgs84 BETWEEN :minLon AND :maxLon;


